// Prisma schema for the Jastip e-commerce storefront.
// See /home/ubuntu/.claude/plans/stateless-snuggling-boole.md for the design rationale.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  READY
  PO
}

enum Courier {
  LION_PARCEL
  WAHANA
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  type        ProductType

  // Final selling price in Rupiah. The jastip fee is already baked in here —
  // there is intentionally no separate fee field anywhere in the schema.
  price Int

  weightGrams Int
  lengthCm    Int
  widthCm     Int
  heightCm    Int

  // Meaningful only for READY products; null means unlimited (PO items are
  // made to order and are never stock-constrained).
  stockQty Int?

  isActive Boolean @default(true)

  // Free-text taxonomy (not an enum) so new categories/groups don't need a
  // migration. Null/empty means "uncategorized" — existing products are left
  // this way until an admin assigns them. group is the top-level nav grouping
  // (e.g. "Skincare"), category the finer filter within it (e.g. "Toner").
  group    String?
  category String?

  // Simple label-only variants (e.g. size/shade) — no separate price or
  // stock per variant, matching how the storefront design treats them.
  variants String[] @default([])

  images     ProductImage[]
  orderItems OrderItem[]

  createdAt DateTime @updatedAt @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([productId])
}

// Manually populated allowlist of staff who may access /admin.
model AdminUser {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique
  email          String   @unique
  name           String
  isSuperAdmin   Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// Auto-provisioned on first successful Google login — unlike AdminUser there
// is no allowlist, any authenticated customer gets a row here.
model Customer {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique
  email          String   @unique
  name           String
  createdAt      DateTime @default(now())

  addresses CustomerAddress[]
  orders    Order[]
}

// A customer's saved shipping addresses, so repeat orders don't require
// retyping. Selecting one at checkout only pre-fills the form — the values
// are still copied onto Order as a frozen snapshot, same as everything else
// on that model.
model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label          String // free text, e.g. "Rumah", "Kantor"
  recipientName  String
  recipientPhone String

  address                 String
  district                String
  city                    String
  province                String
  postalCode              String
  rajaongkirDestinationId String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([customerId])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // e.g. JT-20260714-0001

  // Set when the order was placed while logged in; null for guest checkout.
  // customerName/customerPhone below are still always populated directly
  // from the checkout form either way (frozen snapshot, not read from here).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String

  shippingAddress      String
  shippingDistrict     String
  shippingCity         String
  shippingProvince     String
  shippingPostalCode   String
  rajaongkirDestinationId String

  courier        Courier
  courierService String
  // MAX(actual weight, volumetric weight) summed across the cart — see plan's
  // "Shipping Integration" section for the formula.
  chargeableWeightGrams Int
  shippingCost          Int // frozen at order time, never retroactively changed
  shippingQuoteRaw      Json // raw RajaOngkir response snapshot, for audit

  itemsSubtotal Int
  totalAmount   Int

  status OrderStatus @default(PENDING_PAYMENT)

  paymentProofUrl String? // optional bukti-transfer upload
  resiNumber      String?
  notes           String?

  items OrderItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  shippedAt   DateTime?
  completedAt DateTime?

  @@index([status])
  @@index([customerPhone])
  @@index([customerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Frozen at order time so later product edits never alter past orders.
  productNameSnapshot  String
  productPriceSnapshot Int
  productTypeSnapshot  ProductType
  weightGramsSnapshot  Int
  // Which variant (size/shade/etc) the customer picked in the cart, if any.
  variantSnapshot String?

  qty       Int
  lineTotal Int

  @@index([orderId])
}

// Shared, TTL'd shipping-rate lookup used to conserve the RajaOngkir free
// quota (100 requests/day) across different customers' checkouts.
model ShippingRateCache {
  id                String   @id @default(cuid())
  originId          String
  destinationId     String
  weightBucketGrams Int
  courier           String // "lion" | "wahana"
  responseJson      Json
  fetchedAt         DateTime @default(now())
  expiresAt         DateTime

  @@unique([destinationId, weightBucketGrams, courier])
  @@index([expiresAt])
}

// Guards the RajaOngkir daily free-tier quota.
model ApiUsageCounter {
  date  DateTime @id
  count Int      @default(0)
}

// Owner-editable operational config (bank account, WhatsApp contact, store
// origin) so these can change without a code deploy.
model Settings {
  key   String @id
  value String
}
