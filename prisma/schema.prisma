// Prisma schema for the Jastip e-commerce storefront.
// See /home/ubuntu/.claude/plans/stateless-snuggling-boole.md for the design rationale.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  READY
  PO
}

enum Courier {
  LION_PARCEL
  WAHANA
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  type        ProductType

  // Final selling price in Rupiah. The jastip fee is already baked in here —
  // there is intentionally no separate fee field anywhere in the schema.
  price Int

  weightGrams Int
  lengthCm    Int
  widthCm     Int
  heightCm    Int

  // Meaningful only for READY products; null means unlimited (PO items are
  // made to order and are never stock-constrained).
  stockQty Int?

  isActive Boolean @default(true)

  // Free-text taxonomy (not an enum) so new categories/groups don't need a
  // migration. Null/empty means "uncategorized" — existing products are left
  // this way until an admin assigns them. group is the top-level nav grouping
  // (e.g. "Skincare"), category the finer filter within it (e.g. "Toner").
  group    String?
  category String?

  // LEGACY: label-only variants from before per-variant price/stock. Kept
  // (unused) only so the production deployment that still reads this column
  // keeps working while the new code is previewed against the same database.
  // Drop it in a later migration once ProductVariant is live everywhere.
  legacyVariants String[] @default([]) @map("variants")

  // Every product has at least one variant row. A product without options
  // has a single variant with name "". price and stockQty above are kept in
  // sync from these rows (cheapest variant price, total stock) so listing
  // pages can sort/filter without joining — see lib/product-stock.ts.
  variants ProductVariant[]

  // Pre-Order products: which shopping trip / PO Event they belong to.
  poEventId String?
  poEvent   PoEvent? @relation(fields: [poEventId], references: [id], onDelete: SetNull)

  images     ProductImage[]
  orderItems OrderItem[]
  poItems    PoItem[]
  readySales ReadySale[]

  createdAt DateTime @updatedAt @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@index([poEventId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // "" for the single variant of a product without options.
  name      String
  sortOrder Int    @default(0)

  // Selling price in Rupiah (jastip fee included).
  price Int

  // READY only; null for PO (made to order, never stock-constrained).
  stockQty Int?

  // Weighted average purchase cost per unit ("modal rata-rata"), updated on
  // every purchase stock-in. Owner-only. Null until a cost is first entered.
  avgCost Int?

  stockMovements StockMovement[]
  orderItems     OrderItem[]
  readySales     ReadySale[]

  @@unique([productId, name])
  @@index([productId])
}

enum StockMovementType {
  // Stock bought from a shopping trip — carries a unit cost and moves avgCost.
  PURCHASE
  // Manual correction (recount, damaged, gift) — no cost, avgCost unchanged.
  ADJUSTMENT
}

model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  type StockMovementType
  // Signed: positive adds stock, negative removes it.
  qty  Int
  // Purchase price per unit; PURCHASE only.
  unitCost Int?
  // Stock and average cost right after this movement, for an audit trail.
  stockAfter   Int
  avgCostAfter Int?

  note        String?
  adminUserId String?
  adminName   String?
  createdAt   DateTime @default(now())

  @@index([variantId, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([productId])
}

// Manually populated allowlist of staff who may access /admin.
model AdminUser {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique
  email          String   @unique
  name           String
  isSuperAdmin   Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// Auto-provisioned on first successful Google login — unlike AdminUser there
// is no allowlist, any authenticated customer gets a row here.
model Customer {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique
  email          String   @unique
  name           String
  createdAt      DateTime @default(now())

  addresses CustomerAddress[]
  orders    Order[]
}

// A customer's saved shipping addresses, so repeat orders don't require
// retyping. Selecting one at checkout only pre-fills the form — the values
// are still copied onto Order as a frozen snapshot, same as everything else
// on that model.
model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label          String // free text, e.g. "Rumah", "Kantor"
  recipientName  String
  recipientPhone String

  address                 String
  district                String
  city                    String
  province                String
  postalCode              String
  rajaongkirDestinationId String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([customerId])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // e.g. JT-20260714-0001

  // Set when the order was placed while logged in; null for guest checkout.
  // customerName/customerPhone below are still always populated directly
  // from the checkout form either way (frozen snapshot, not read from here).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String

  shippingAddress      String
  shippingDistrict     String
  shippingCity         String
  shippingProvince     String
  shippingPostalCode   String
  rajaongkirDestinationId String

  courier        Courier
  courierService String
  // MAX(actual weight, volumetric weight) summed across the cart — see plan's
  // "Shipping Integration" section for the formula.
  chargeableWeightGrams Int
  shippingCost          Int // frozen at order time, never retroactively changed
  shippingQuoteRaw      Json // raw RajaOngkir response snapshot, for audit

  itemsSubtotal Int
  totalAmount   Int

  status OrderStatus @default(PENDING_PAYMENT)

  paymentProofUrl String? // optional bukti-transfer upload
  resiNumber      String?
  notes           String?

  items OrderItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  shippedAt   DateTime?
  completedAt DateTime?

  @@index([status])
  @@index([customerPhone])
  @@index([customerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Frozen at order time so later product edits never alter past orders.
  productNameSnapshot  String
  productPriceSnapshot Int
  productTypeSnapshot  ProductType
  weightGramsSnapshot  Int
  // Which variant (size/shade/etc) the customer picked in the cart, if any.
  variantSnapshot String?

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Average purchase cost per unit at the moment of sale (owner-only data,
  // for profit reports). Null when unknown, e.g. PO items or no cost entered.
  costSnapshot Int?

  qty       Int
  lineTotal Int

  @@index([orderId])
}

// Shared, TTL'd shipping-rate lookup used to conserve the RajaOngkir free
// quota (100 requests/day) across different customers' checkouts.
model ShippingRateCache {
  id                String   @id @default(cuid())
  originId          String
  destinationId     String
  weightBucketGrams Int
  courier           String // "lion" | "wahana"
  responseJson      Json
  fetchedAt         DateTime @default(now())
  expiresAt         DateTime

  @@unique([destinationId, weightBucketGrams, courier])
  @@index([expiresAt])
}

// Guards the RajaOngkir daily free-tier quota.
model ApiUsageCounter {
  date  DateTime @id
  count Int      @default(0)
}

// Owner-editable operational config (bank account, WhatsApp contact, store
// origin) so these can change without a code deploy.
model Settings {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// Rekap Order: orders taken during live shopping / WhatsApp, separate from
// web checkout orders (Order). Customers here are identified by name + phone
// (no login), both unique so two buyers can never be mixed up.
// ---------------------------------------------------------------------------

enum PoEventStatus {
  OPEN
  ARCHIVED
}

/// One shopping trip / live session ("PO Event"), e.g. "Live Jepang 20 Nov".
model PoEvent {
  id        String        @id @default(cuid())
  name      String
  status    PoEventStatus @default(OPEN)
  createdAt DateTime      @default(now())

  items    PoItem[]
  orders   PoOrder[]
  products Product[]

  @@index([status, createdAt])
}

/// A WhatsApp/live customer. phone is normalized to 62xxxxxxxxxx.
model Buyer {
  id      String @id @default(cuid())
  name    String
  // Lower-cased, single-spaced name, so "Sinta" and "sinta " can't both exist.
  nameKey String @unique
  phone   String @unique

  createdAt DateTime @default(now())

  poOrders   PoOrder[]
  readySales ReadySale[]
  waOrders   WaOrder[]
}

/// One line of the shopping list in a PO Event: an item (+ variant) that
/// buyers ordered. How many were actually bought is "got"; they are handed
/// out to orders first-come-first-served (FIFO by order time).
model PoItem {
  id      String  @id @default(cuid())
  eventId String
  event   PoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Normalized name|variant, unique within the event.
  key     String
  name    String
  variant String @default("")

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Photo for items typed in by hand (catalog products use their own photo).
  imageUrl String?

  // Selling price per pcs; 0 = not decided yet.
  price   Int     @default(0)
  // Purchase price per pcs (owner only).
  cost    Int?
  got     Int     @default(0)
  // Marked when the store ran out: orders not covered won't be fulfilled.
  soldOut Boolean @default(false)

  createdAt DateTime @default(now())

  orders PoOrder[]

  @@unique([eventId, key])
}

model PoOrder {
  id      String  @id @default(cuid())
  eventId String
  event   PoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  itemId  String
  item    PoItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyerId String
  buyer   Buyer   @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  qty       Int
  createdAt DateTime @default(now())
  adminName String?

  @@index([eventId, createdAt])
  @@index([itemId])
  @@index([buyerId])
}

/// A Ready Stock sale recorded during live shopping; takes stock right away.
model ReadySale {
  id      String @id @default(cuid())
  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshots, so later product edits never change past sales.
  productName  String
  variantName  String @default("")
  category     String?
  qty          Int
  price        Int
  // Average purchase cost per pcs at the time of sale (owner only).
  costSnapshot Int?

  adminName String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([buyerId])
}

enum WaOrderStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// An order a shopper sent from the web's "Order via WhatsApp" button. It
/// waits here until the admin sees the chat and confirms it, then its lines
/// go into Rekap Order (Pre-Order) and Ready Stock sales.
model WaOrder {
  id   String @id @default(cuid())
  // Short code printed in the WhatsApp message, to match chat and record.
  code String @unique

  name    String
  phone   String
  address String
  note    String?

  /// [{ productId, variantId, name, variant, qty, price, type, batch, eventId }]
  lines Json
  total Int

  status      WaOrderStatus @default(PENDING)
  buyerId     String?
  buyer       Buyer?        @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  handledBy   String?
  handledAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@index([phone])
}
