# Database (Supabase Transaction Pooler connection string, used at runtime)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
# Session pooler connection, used only by `prisma migrate` (DDL needs a non
# transaction-pooled connection)
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# RajaOngkir (Komerce) shipping API — server-side only, never expose to the browser
RAJAONGKIR_API_KEY=""
# Numeric destination id (from /destination/domestic-destination) for the store's pickup location
RAJAONGKIR_ORIGIN_ID=""
